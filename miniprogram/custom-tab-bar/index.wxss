.tab-shell { position:fixed; left:22rpx; right:174rpx; bottom:env(safe-area-inset-bottom); z-index:100; display:flex; height:108rpx; overflow:hidden; border-radius:0 34rpx 0 0; box-shadow:0 6rpx 20rpx rgba(75,61,45,.12); }
.tab-paper { position:absolute; inset:0; width:100%; height:100%; }
.tab-item { position:relative; z-index:1; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3rpx; color:#77716b; font-size:22rpx; }
.tab-item.active { color:#435440; font-weight:650; }
.tab-whisper{position:fixed;right:18rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));z-index:99;width:146rpx;white-space:pre-line;color:#756d63;font-family:"STKaiti","KaiTi",serif;font-size:19rpx;line-height:1.45;transform:rotate(-4deg);}
