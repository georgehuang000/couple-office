.calendar-page{padding-left:18rpx;padding-right:18rpx}
.calendar-intro{position:relative;min-height:150rpx;padding:14rpx 22rpx 0}
.calendar-intro>text{display:block;color:#31412f;font-family:"STKaiti","KaiTi",serif;font-size:42rpx;font-weight:700;line-height:1.25;letter-spacing:2rpx}
.calendar-intro>text>text{color:#e99b82}.intro-note{position:absolute;right:20rpx;top:10rpx;width:190rpx;padding:16rpx 20rpx;background:rgba(255,253,248,.76);color:#797167;font-family:"STKaiti","KaiTi",serif;font-size:20rpx;line-height:1.5;transform:rotate(-3deg)}
.calendar-paper{position:relative;height:520rpx;margin:0 0 12rpx;overflow:hidden;border-radius:6rpx;box-shadow:0 8rpx 20rpx rgba(92,75,53,.09)}
.paper-bg{position:absolute;inset:0;width:100%;height:100%}
.calendar-inner{position:relative;z-index:1;padding:21rpx 38rpx}
.month-nav{display:flex;align-items:center;justify-content:center;gap:50rpx;padding:0 10rpx 12rpx}.month-nav>text:first-child,.month-nav>text:last-child{padding:0 12rpx;color:#333b32;font-size:43rpx}.month-title{font-family:"PingFang SC",sans-serif;font-size:30rpx;font-weight:700;color:#242923}
.week-row,.days{display:grid;grid-template-columns:repeat(7,1fr)}.week-row text{text-align:center;color:#77716a;font-size:21rpx}.day{position:relative;display:flex;align-items:center;justify-content:center;height:62rpx;margin:3rpx;border-radius:50%;color:#242823;font-size:22rpx}.muted-day{opacity:.34}.day.selected{background:#63725b;color:white}.day.today{background:#f7e1d8;color:#4f4740}.event-dot{position:absolute;bottom:1rpx;width:6rpx;height:6rpx;border-radius:50%;background:#e99b82}.day.selected .event-dot{background:#f5c0ad}.calendar-whisper{position:absolute;right:30rpx;bottom:11rpx;color:#756e65;font-family:"STKaiti","KaiTi",serif;font-size:18rpx;line-height:1.4;text-align:right;transform:rotate(-3deg)}
.agenda-paper,.upcoming-paper{padding:13rpx 18rpx;border:1rpx solid rgba(164,145,121,.14);border-radius:18rpx;background:rgba(255,253,248,.9);box-shadow:0 6rpx 16rpx rgba(83,68,50,.07)}
.agenda-paper{margin-top:-42rpx}
.agenda-heading,.upcoming-heading{display:flex;align-items:flex-start;justify-content:space-between;padding:2rpx 7rpx 9rpx;border-bottom:1rpx solid #e9dfd3}.agenda-heading>text:first-child,.upcoming-heading>text:first-child{font-size:30rpx;font-weight:700;text-decoration:underline;text-decoration-color:#efad96;text-decoration-thickness:8rpx;text-underline-offset:-3rpx}.agenda-heading>text:last-child{color:#766e64;font-family:"STKaiti","KaiTi",serif;font-size:17rpx;line-height:1.35;text-align:right;white-space:pre-line}
.agenda-row{position:relative;display:flex;align-items:center;min-height:91rpx;padding:8rpx 4rpx;border-bottom:1rpx solid #e8dfd4}.agenda-row:last-child{border-bottom:0}.agenda-icon{width:58rpx;height:58rpx;margin-right:13rpx;border-radius:13rpx}.agenda-copy{width:255rpx}.agenda-title{display:block;font-size:27rpx;font-weight:700}.agenda-meta{display:flex;align-items:center;margin-top:5rpx;color:#847d75;font-size:18rpx}.agenda-meta image{width:22rpx!important;height:22rpx!important;margin:0 4rpx 0 0!important;border-radius:0!important}.agenda-note{position:absolute;right:14rpx;top:29rpx;width:245rpx;color:#746c63;font-family:"STKaiti","KaiTi",serif;font-size:19rpx;line-height:1.4;text-align:center;transform:rotate(-3deg)}.meal-photo{position:absolute;right:12rpx;bottom:2rpx;width:82rpx;height:70rpx;border:7rpx solid #fff;box-shadow:0 3rpx 9rpx rgba(0,0,0,.14);transform:rotate(8deg)}.agenda-row.with-meal .agenda-note{right:100rpx;width:170rpx}.agenda-actions{position:absolute;right:8rpx;bottom:2rpx;display:flex;gap:12rpx;color:#9a7465;font-size:16rpx}
.upcoming-paper{margin-top:13rpx}.upcoming-heading>text:last-child{color:#6e7569;font-family:"STKaiti","KaiTi",serif;font-size:20rpx}.upcoming-row{position:relative;display:flex;align-items:center;min-height:84rpx;padding:8rpx 4rpx;border-bottom:1rpx solid #e8dfd4}.upcoming-row:last-child{border-bottom:0}.upcoming-row>image{width:56rpx;height:56rpx;margin-right:14rpx;border-radius:12rpx}.upcoming-note{width:225rpx;color:#766e64;font-family:"STKaiti","KaiTi",serif;font-size:18rpx;line-height:1.35;text-align:right}
.empty.compact{padding:30rpx}.sheet{z-index:60}
