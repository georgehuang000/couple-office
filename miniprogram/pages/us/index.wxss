.us-page{padding-left:18rpx;padding-right:18rpx}
.us-journal-hero{position:relative;height:490rpx;margin:0 0 12rpx;overflow:hidden}.us-frame{position:absolute;inset:0;z-index:2;width:100%;height:100%}.us-photo{position:absolute;z-index:1;right:38rpx;top:62rpx;width:270rpx;height:205rpx;transform:rotate(6deg)}
.us-title-copy{position:absolute;z-index:3;left:27rpx;top:24rpx;width:430rpx}.us-title-copy>text:first-child{display:block;color:#30402f;font-family:"STKaiti","KaiTi",serif;font-size:38rpx;font-weight:700;line-height:1.25;white-space:nowrap}.us-title-copy>text:first-child text{color:#e99b82}.us-title-copy>text:last-child{display:block;margin-top:16rpx;color:#716a62;font-family:"STKaiti","KaiTi",serif;font-size:22rpx;line-height:1.5;white-space:pre-line}
.together-note{position:absolute;z-index:4;left:17rpx;bottom:5rpx;width:505rpx;height:174rpx}.together-note>image{position:absolute;inset:0;width:100%;height:100%}.together-note>view{position:relative;z-index:1;padding:28rpx 43rpx}.together-note>view>text:first-child{display:block;font-size:24rpx;font-weight:700}.together-note>view>view{display:flex;align-items:flex-end}.together-note>view>view text:first-child{color:#344431;font-family:"STKaiti","KaiTi",serif;font-size:66rpx;line-height:.95}.together-note>view>view text:last-child{margin:0 0 7rpx 12rpx;font-size:23rpx}.together-note>view>text:last-child{display:block;margin-top:9rpx;color:#777067;font-family:"STKaiti","KaiTi",serif;font-size:18rpx}.photo-note{position:absolute;z-index:4;right:28rpx;bottom:31rpx;width:185rpx;color:#756d64;font-family:"STKaiti","KaiTi",serif;font-size:18rpx;line-height:1.45;text-align:center;transform:rotate(3deg)}
.memory-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.memory-card{position:relative;min-height:435rpx;padding:14rpx 13rpx;border:1rpx solid rgba(164,145,121,.14);border-radius:18rpx;background:rgba(255,253,248,.92);box-shadow:0 7rpx 17rpx rgba(83,68,50,.08)}.memory-heading,.lower-heading{display:flex;align-items:center;height:55rpx;border-bottom:1rpx solid #e5ddd2}.memory-heading image,.lower-heading image{width:40rpx;height:40rpx;margin-right:8rpx;border-radius:9rpx}.memory-heading>text:nth-child(2),.lower-heading>text:nth-child(2){flex:1;font-size:25rpx;font-weight:700}.memory-heading>text:last-child,.lower-heading>text:last-child{font-size:34rpx}.memory-row{position:relative;display:flex;align-items:center;min-height:70rpx;border-bottom:1rpx solid #e6ded3}.memory-row>image{width:42rpx;height:42rpx;margin-right:8rpx;border-radius:9rpx}.memory-row .grow>text:first-child{display:block;font-size:21rpx;font-weight:600}.memory-row .grow>text:last-child{display:block;color:#8b857e;font-size:16rpx}.memory-row>text{color:#8d867d;font-size:17rpx;white-space:nowrap}.memory-row>text text{color:#c8755d;font-size:25rpx}.row-tools{position:absolute;right:0;bottom:0;display:flex;gap:5rpx;color:#96776b;font-size:14rpx}.card-add{display:inline-flex;align-items:center;margin-top:10rpx;padding:6rpx 12rpx;border:1rpx solid #ddd7cc;border-radius:20rpx;color:#66715f;font-size:17rpx}
.wish-reference-card{overflow:hidden}.wish-reference-row{display:flex;align-items:center;height:55rpx;border-bottom:1rpx solid #e7dfd4}.wish-reference-row image{width:34rpx;height:34rpx;margin-right:10rpx;border-radius:8rpx}.wish-reference-row text{font-size:20rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.english-note{position:absolute;right:13rpx;bottom:10rpx;color:#8c8176;font-family:cursive;font-size:18rpx;line-height:1.1;white-space:pre-line;transform:rotate(-8deg)}
.lower-grid{display:grid;grid-template-columns:1.38fr .82fr;gap:12rpx;margin-top:12rpx}.album-panel,.quiet-panel{position:relative;height:256rpx;overflow:hidden;border-radius:18rpx;box-shadow:0 7rpx 17rpx rgba(83,68,50,.08)}.album-base,.quiet-base{position:absolute;inset:0;width:100%;height:100%}.lower-heading{position:relative;z-index:2;margin:9rpx 15rpx 0}.album-photos{position:absolute;z-index:3;left:23rpx;top:73rpx;display:flex;gap:8rpx}.album-photos image{width:83rpx;height:96rpx;border:5rpx solid #fff;border-radius:5rpx;box-shadow:0 2rpx 7rpx rgba(0,0,0,.11)}.album-note{position:absolute;z-index:3;left:114rpx;bottom:20rpx;color:#7a7269;font-family:"STKaiti","KaiTi",serif;font-size:17rpx}.quiet-copy{position:absolute;z-index:3;left:22rpx;right:15rpx;top:72rpx;color:#6e625a;font-family:"STKaiti","KaiTi",serif;font-size:18rpx;line-height:1.45;white-space:pre-line;transform:rotate(-2deg)}
.wish-manage,.account-below{margin-top:22rpx}.card-actions{display:flex;flex-wrap:wrap;gap:9rpx;margin-top:13rpx}.notice{display:flex;align-items:center;gap:14rpx}.notice.read{opacity:.56}.notice-dot{width:13rpx;height:13rpx;flex:0 0 13rpx;border-radius:50%;background:#e79b83}.notice.read .notice-dot{background:#bbb}.setting-row{display:flex;justify-content:space-between;padding:20rpx 4rpx;border-bottom:1rpx solid #e8dfd3}.setting-row.danger{color:#a6493d}.settings-note{display:block;margin-top:18rpx;color:#90877d;font-size:21rpx;line-height:1.6}.category-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;padding:10rpx}
