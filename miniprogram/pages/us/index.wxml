<view class="page us-page">
  <view class="brand"><image class="brand-mark" src="/assets/brand-mark.png" /><view><text class="brand-title">两人事务所</text><text class="brand-subtitle">把平凡的日子，过成我们喜欢的样子</text></view><text class="brand-note">和你在一起，\n每一天都很喜欢 ♡</text><text wx:if="{{demo}}" class="demo-stamp">只读演示</text></view>
  <view wx:if="{{loading}}" class="empty">正在整理我们的记录…</view>
  <block wx:elif="{{auth}}">
    <view class="us-journal-hero">
      <image class="us-photo" src="/assets/photo-sunset.jpg" mode="aspectFill" />
      <image class="us-frame" src="/assets/us-hero.png" mode="scaleToFill" />
      <view class="us-title-copy"><text>谢谢你出现在我的生活里 <text>♥</text></text><text>两个普通的人，\n因为彼此，变成了更好的人。\n未来的日子，也要一直在一起呀！</text></view>
      <view class="together-note"><image src="/assets/approval-note.png" mode="scaleToFill" /><view><text>在一起</text><view><text>{{togetherDays}}</text><text>天</text></view><text>感谢有你，让平凡的每一天都有了意义。♡</text></view></view>
      <text class="photo-note">一起看过很多风景\n以后也要一起看更多 ♡</text>
    </view>

    <view class="memory-grid">
      <view class="memory-card"><view class="memory-heading"><image src="/assets/us-calendar.png" /><text>我们的重要时刻</text><text>›</text></view><view wx:for="{{anniversaries}}" wx:key="_id" class="memory-row"><image src="{{item.icon_path}}" /><view class="grow"><text>{{item.title}}</text><text>{{item.date_text}}</text></view><text>已过 <text>{{item.elapsed_text}}</text> 天</text><view wx:if="{{!demo}}" class="row-tools"><text data-type="anniversary" data-item="{{item}}" bindtap="openSheet">改</text><text data-item="{{item}}" bindtap="deleteAnniversary">删</text></view></view><view class="card-add" data-type="anniversary" bindtap="openSheet">+　添加重要时刻</view></view>
      <view class="memory-card wish-reference-card"><view class="memory-heading"><image src="/assets/us-star.png" /><text>我们的愿望清单</text><text>›</text></view><view wx:for="{{referenceWishes}}" wx:key="_id" class="wish-reference-row" data-type="wish" data-item="{{item}}" bindtap="openSheet"><image src="{{item.status === 'completed' ? '/assets/check-done.png' : '/assets/check-empty.png'}}" /><text class="{{item.status === 'completed' ? 'completed' : ''}}">{{item.title}}</text></view><view class="card-add" data-type="wish" bindtap="openSheet">+　添加心愿</view><text class="english-note">Good things\ntogether ♡</text></view>
    </view>

    <view class="lower-grid">
      <view class="album-panel"><image class="album-base" src="/assets/album-card.png" mode="scaleToFill" /><view class="lower-heading"><image src="/assets/us-photo.png" /><text>我们的相册</text><text>›</text></view><view class="album-photos"><image src="/assets/photo-sunset.jpg" mode="aspectFill" /><image src="/assets/photo-dog.jpg" mode="aspectFill" /><image src="/assets/photo-heart.jpg" mode="aspectFill" /></view><text class="album-note">收藏属于我们的温柔时刻 ♡</text></view>
      <view class="quiet-panel"><image class="quiet-base" src="/assets/quiet-card.png" mode="scaleToFill" /><view class="lower-heading"><image src="/assets/us-message.png" /><text>悄悄话</text><text>›</text></view><text class="quiet-copy">和你在一起，\n就是我最喜欢的日常。\n希望我们一直这样，\n一年又一年。♡\n\n　　—— 致我们</text></view>
    </view>

    <view wx:if="{{!demo}}" class="wish-manage"><view class="row-between"><text class="section-title">管理心愿</text><text data-type="wish" bindtap="openSheet">+写下一个</text></view><view wx:for="{{visibleWishes}}" wx:key="_id" class="paper-card compact"><view class="row-between"><text class="title">{{item.title}}</text><text class="small muted">{{item.status_text}}</text></view><view class="card-actions"><button wx:if="{{item.status === 'pending'}}" class="mini-button light" data-item="{{item}}" bindtap="planWish">加入计划</button><button class="mini-button light" data-item="{{item}}" data-target="task" bindtap="convertWish">转待办</button><button class="mini-button light" data-item="{{item}}" data-target="event" bindtap="convertWish">转日程</button><button class="mini-button" data-item="{{item}}" bindtap="completeWish">完成</button><button class="mini-button light" data-item="{{item}}" bindtap="deleteWish">删除</button></view></view></view>
    <view wx:if="{{!demo}}" class="account-below"><text class="section-title">最近消息</text><view wx:if="{{!notifications.length}}" class="paper-card compact muted">还没有新消息。</view><view wx:for="{{notifications}}" wx:key="_id" class="paper-card compact notice {{item.read_at ? 'read' : ''}}" data-item="{{item}}" bindtap="markRead"><view class="notice-dot"></view><view><text class="title">{{item.preview}}</text><text class="small muted">{{item.time_text}}</text></view></view><text class="section-title">数据与账号</text><view class="paper-card settings"><view class="setting-row" bindtap="exportData"><text>导出我们的数据</text><text>›</text></view><view class="setting-row" bindtap="archiveCouple"><text>解绑并归档当前空间</text><text>›</text></view><view class="setting-row danger" bindtap="deleteAccount"><text>删除我的账号</text><text>›</text></view><text class="settings-note">订阅消息开关当前关闭；核心协作只依赖站内消息。</text></view></view>
  </block>

  <view wx:if="{{showSheet}}" class="modal-mask" bindtap="closeSheet"><view class="sheet" catchtap="stopBubble"><view class="row-between"><text class="sheet-title">{{sheetType === 'wish' ? (editingWish ? '编辑心愿' : '写下心愿') : (editingAnniversary ? '编辑纪念日' : '添加纪念日')}}</text><text class="muted" bindtap="closeSheet">关闭</text></view><block wx:if="{{sheetType === 'wish'}}"><view class="field"><text class="field-label">心愿名称</text><input class="input" data-field="title" value="{{wishForm.title}}" bindinput="updateWishForm" placeholder="想一起完成什么？" /></view><view class="field"><text class="field-label">具体想法</text><textarea class="textarea" data-field="description" value="{{wishForm.description}}" bindinput="updateWishForm" /></view><view class="field"><text class="field-label">分类</text><radio-group data-field="category" bindchange="updateWishForm" class="category-grid"><label><radio value="eat" checked="{{wishForm.category === 'eat'}}" color="#66775f" />吃一顿</label><label><radio value="go" checked="{{wishForm.category === 'go'}}" color="#66775f" />去走走</label><label><radio value="buy" checked="{{wishForm.category === 'buy'}}" color="#66775f" />买下来</label><label><radio value="do" checked="{{wishForm.category === 'do'}}" color="#66775f" />一起做</label></radio-group></view><view class="field"><text class="field-label">目标日期</text><picker mode="date" data-field="target_date" value="{{wishForm.target_date}}" bindchange="updateWishForm"><view class="picker">{{wishForm.target_date || '不设日期'}}</view></picker></view></block><block wx:else><view class="field"><text class="field-label">纪念日名称</text><input class="input" data-field="title" value="{{anniversaryForm.title}}" bindinput="updateAnnForm" placeholder="例如：第一次旅行" /></view><view class="field"><text class="field-label">原始日期</text><picker mode="date" data-field="original_date" value="{{anniversaryForm.original_date}}" bindchange="updateAnnForm"><view class="picker">{{anniversaryForm.original_date}}</view></picker></view><text class="body small muted">每年重复提醒；2月29日在非闰年按2月28日计算。</text></block><button class="primary-button" loading="{{submitting}}" bindtap="submitSheet">保存</button></view></view>
</view>
