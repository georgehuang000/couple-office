.items-page{padding-left:0;padding-right:0}
.journal-hero{position:relative;height:382rpx;margin:0;overflow:hidden}
.hero-frame{position:absolute;inset:0;width:100%;height:100%}
.hero-main-copy{position:absolute;left:38rpx;top:30rpx;width:450rpx}
.hero-heading{display:flex;align-items:center;gap:15rpx}
.journal-title{color:#35422d;font-family:"JournalTitle","KaiTi",serif;font-size:55rpx;font-weight:400;line-height:1.25;letter-spacing:2rpx}
.hero-heart{width:39rpx;height:39rpx}
.journal-subtitle{display:block;margin-top:13rpx;color:#80796f;font-family:"JournalHand","KaiTi",serif;font-size:24rpx;line-height:1.5;letter-spacing:2rpx;white-space:pre-line}
.paper-quote{position:absolute;color:#82776b;font-family:"JournalHand","KaiTi",serif;font-size:24rpx;line-height:1.45;white-space:pre-line}
.left-quote{left:105rpx;top:229rpx;width:294rpx;transform:rotate(-8deg)}
.right-quote{right:32rpx;bottom:34rpx;width:197rpx;text-align:left;transform:rotate(-5deg);font-size:22rpx}
.reference-tabs{position:relative;display:flex;align-items:center;gap:14rpx;height:104rpx;box-sizing:border-box;padding:14rpx 34rpx 17rpx}
.reference-tab{box-sizing:border-box;width:133rpx;height:58rpx;line-height:58rpx;border-radius:20rpx;background:rgba(217,206,188,.23);text-align:center;color:#34332f;font-size:27rpx}
.reference-tab.active{background:#71775f;color:#fffdf8}
.tabs-whisper{position:absolute;right:25rpx;top:25rpx;white-space:pre-line;font-family:"JournalHand","KaiTi",serif;color:#8b7b6b;font-size:21rpx;line-height:1.35;transform:rotate(-9deg)}
.task-list-paper{margin:0 19rpx}
.reference-task{box-sizing:border-box;position:relative;display:grid;grid-template-columns:36rpx 56rpx minmax(0,1fr) 78rpx 103rpx;column-gap:25rpx;align-items:center;min-height:87rpx;margin:0 0 12rpx;padding:9rpx 24rpx}
.reference-task>.card-surface{z-index:0}
.reference-task>image:not(.card-surface),.reference-task>view,.reference-task>text{position:relative;z-index:1}
.reference-check{width:36rpx;height:36rpx}
.task-icon{width:56rpx;height:56rpx}
.task-copy{min-width:0}
.task-name{display:block;overflow:hidden;color:#1e221f;font-size:25rpx;font-weight:500;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}
.task-desc{display:block;margin-top:2rpx;overflow:hidden;color:#8a867f;font-size:20rpx;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}
.task-time{color:#87817b;font-size:22rpx;text-align:center}
.task-trailing{text-align:center;min-width:0}
.task-badge{display:inline-block;padding:5rpx 12rpx;border-radius:26rpx;background:rgba(250,221,207,.7);color:#bf7b5f;font-family:"JournalHand","KaiTi",serif;font-size:20rpx;white-space:nowrap}
.tiny-avatars{display:flex;justify-content:center;gap:4rpx}
.tiny-avatars image{width:43rpx;height:43rpx;border-radius:50%}
.live-actions{position:absolute!important;right:15rpx;bottom:0;z-index:6;display:flex;gap:5rpx}
.live-actions button{min-width:45rpx;height:28rpx;padding:0 7rpx;background:#f3ecdf;color:#716b64;font-size:15rpx;line-height:28rpx}
.approval-hero{height:365rpx}
.approval-hero .hero-main-copy{top:28rpx;width:455rpx}
.approval-hero .journal-subtitle{font-size:22rpx;line-height:1.5;letter-spacing:1rpx}
.approval-hero .left-quote{left:60rpx;top:230rpx;width:355rpx;font-size:22rpx;line-height:1.5;transform:rotate(-6deg)}
.approval-hero .right-quote{bottom:25rpx;right:42rpx;width:232rpx;font-size:20rpx;transform:rotate(5deg)}
.approval-list-paper{margin:0 16rpx}
.reference-approval{box-sizing:border-box;position:relative;height:203rpx;margin:0 0 13rpx;padding:0}
.approval-item-icon{position:absolute;top:19rpx;left:25rpx;width:68rpx;height:68rpx;border-radius:20rpx}
.approval-item-copy{position:absolute;top:17rpx;left:111rpx;right:266rpx}
.approval-name{display:block;color:#1d211f;font-size:26rpx;font-weight:500;line-height:1.4}
.approval-desc{display:block;margin-top:2rpx;color:#7d7a74;font-size:22rpx;white-space:nowrap}
.approval-meta{position:absolute;display:flex;align-items:center;left:30rpx;top:99rpx;color:#908a83;font-size:19rpx;line-height:1.4}
.approval-meta image{width:43rpx;height:43rpx;margin-right:5rpx;border-radius:50%}
.approval-meta text{margin-left:12rpx;white-space:pre-line}
.approval-note-text{position:absolute;left:51rpx;bottom:15rpx;padding:3rpx 15rpx;border-radius:24rpx;background:rgba(250,221,211,.55);color:#958170;font-family:"JournalHand","KaiTi",serif;font-size:21rpx;line-height:1.5;white-space:nowrap}
.approval-status{position:absolute;right:163rpx;top:27rpx;padding:6rpx 17rpx;border-radius:24rpx;background:#fae4d7;color:#bd7351;font-size:22rpx}
.approval-arrow{position:absolute;right:19rpx;top:34rpx;width:26rpx;height:26rpx}
.approval-actions{position:absolute;right:21rpx;top:109rpx;display:flex;gap:15rpx}
.approval-actions button{display:flex;align-items:center;justify-content:center;gap:9rpx;box-sizing:border-box;height:53rpx;min-width:126rpx;margin:0;padding:0 16rpx;border:1.5rpx solid #dbd4ca;border-radius:22rpx;background:rgba(255,255,255,.15);color:#343430;font-size:24rpx;line-height:53rpx}
.approval-actions button.agree{border-color:#747e62;background:#747e62;color:#fffdf8;box-shadow:0 4rpx 6rpx #93897820}
.approval-actions image{width:25rpx;height:25rpx}
.task-footer{position:relative;height:160rpx;margin-top:21rpx}
.wide-add{display:flex;align-items:center;justify-content:center;gap:17rpx;width:343rpx;height:69rpx;margin-left:128rpx;border-radius:34rpx;background:#d7d9c5;color:#4c5940;font-size:27rpx;font-weight:500}
.wide-add image{width:37rpx;height:37rpx}
.footer-whisper{position:absolute;right:28rpx;top:17rpx;width:225rpx;white-space:pre-line;color:#8b7b6b;font-family:"JournalHand","KaiTi",serif;font-size:22rpx;line-height:1.45;transform:rotate(-9deg)}
.approval-footer{position:relative;height:33rpx;margin-top:-9rpx}
.approval-footer text{position:absolute;right:25rpx;bottom:0;color:#8b7b6b;font-family:"JournalHand","KaiTi",serif;font-size:21rpx;line-height:1.4;white-space:pre-line;transform:rotate(-9deg)}
.mode-actions{display:flex;justify-content:center;gap:40rpx;margin:22rpx 25rpx 0;padding:17rpx 0;color:#7b806e;font-size:23rpx;border-top:1rpx solid #e4dbce}
.empty image{display:block;width:220rpx;height:150rpx;margin:0 auto 12rpx}.radio-row{display:flex;gap:56rpx;padding:12rpx}.loading-more{text-align:center;padding:15rpx}
