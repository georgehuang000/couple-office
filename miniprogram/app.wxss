page {
  background: #f7f4ef;
  color: #2f2923;
  font-size: 30rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.card {
  margin: 20rpx 0;
  padding: 28rpx;
  border: 1rpx solid #ebe3d9;
  border-radius: 20rpx;
  background: #fffdf9;
}

.title { display: block; font-size: 40rpx; font-weight: 600; }
.body { display: block; margin-top: 16rpx; color: #70675f; line-height: 1.6; }
.muted { color: #938980; }
.primary-button {
  margin-top: 28rpx;
  border: 0;
  border-radius: 14rpx;
  background: #846d52;
  color: #fff;
  font-size: 30rpx;
}
.status { display: block; margin-top: 16rpx; line-height: 1.6; }
.token-input { margin-top: 24rpx; padding: 18rpx; border: 1rpx solid #d9cec1; border-radius: 12rpx; background: #fff; }
.success { color: #327252; }
.error { color: #b34a42; }
