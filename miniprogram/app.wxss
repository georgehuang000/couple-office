page { --paper:#fffdf8; --canvas:#f3eee4; --ink:#252a24; --muted:#837c73; --sage:#66755f; --sage-soft:#e2e7dc; --peach:#e99b82; --peach-soft:#fae5dc; --line:#e5dbce; background-color:var(--canvas); background-image:url('/assets/tab-paper.png'); background-size:100% 250rpx; color:var(--ink); font-family:"PingFang SC","Microsoft YaHei",sans-serif; font-size:26rpx; }
button::after { border:0; }
.page { min-height:100vh; box-sizing:border-box; padding:82rpx 22rpx calc(122rpx + env(safe-area-inset-bottom)); background:rgba(246,241,232,.74); }
.page.no-tab { padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); }
.brand { position:relative;display:flex; align-items:center; gap:12rpx; min-height:102rpx;margin:0 6rpx 12rpx; }
.brand-mark { width:68rpx; height:68rpx; }
.brand-title { display:block; font-family:"STKaiti","KaiTi",serif; font-size:43rpx; font-weight:700; letter-spacing:4rpx; color:#41513f; }
.brand-subtitle { display:block; margin-top:1rpx; color:#817970; font-size:20rpx; letter-spacing:1rpx; }
.brand-note{position:absolute;right:2rpx;bottom:2rpx;width:180rpx;text-align:right;color:#6f685f;font-family:"STKaiti","KaiTi",serif;font-size:20rpx;line-height:1.35;transform:rotate(-4deg);}
.demo-stamp{position:absolute;right:205rpx;top:4rpx;padding:5rpx 12rpx;border:1rpx solid rgba(119,95,47,.25);border-radius:20rpx;background:#fff3cf;color:#775f2f;font-size:18rpx;}
.section-title { display:block; margin:24rpx 8rpx 12rpx; font-family:"STKaiti","KaiTi",serif; font-size:34rpx; font-weight:700; color:#344633; }
.section-subtitle { display:block; margin:-10rpx 8rpx 20rpx; color:var(--muted); font-size:25rpx; }
.paper-card { position:relative; box-sizing:border-box; margin:12rpx 0; padding:20rpx; overflow:hidden; border:1rpx solid rgba(150,129,104,.14); border-radius:20rpx; background:rgba(255,253,248,.94); box-shadow:0 7rpx 18rpx rgba(92,75,53,.08); }
.paper-card.compact { padding:20rpx 22rpx; }
.row { display:flex; align-items:center; }
.row-between { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.grow { flex:1; min-width:0; }
.title { display:block; font-size:32rpx; font-weight:650; color:var(--ink); }
.body { display:block; margin-top:8rpx; line-height:1.65; color:#655f58; }
.muted { color:var(--muted); }
.small { font-size:24rpx; }
.hero { position:relative; min-height:320rpx; margin:6rpx 0 24rpx; overflow:hidden; }
.hero-bg { position:absolute; inset:0; width:100%; height:100%; }
.hero-copy { position:relative; z-index:1; width:50%; padding:56rpx 0 0 48rpx; }
.hero-title { display:block; font-family:"STKaiti","KaiTi",serif; font-size:48rpx; font-weight:700; line-height:1.3; color:#344633; }
.hero-note { display:block; margin-top:18rpx; font-size:25rpx; line-height:1.6; color:#7c746c; }
.avatar-pair { display:flex; align-items:center; }
.avatar { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin-left:-12rpx; border:4rpx solid var(--paper); border-radius:50%; background:var(--sage-soft); color:var(--sage); font-size:24rpx; font-weight:700; }
.avatar:first-child { margin-left:0; }
.avatar.peach { background:var(--peach-soft); color:#a75e4a; }
.pill { display:inline-flex; align-items:center; justify-content:center; min-height:46rpx; padding:0 20rpx; border-radius:24rpx; background:var(--peach-soft); color:#b96850; font-size:23rpx; }
.pill.sage { background:var(--sage-soft); color:var(--sage); }
.segmented { display:flex; gap:12rpx; padding:8rpx; border-radius:24rpx; background:rgba(255,255,255,.55); }
.segment { flex:1; padding:15rpx 10rpx; border-radius:18rpx; text-align:center; color:#716a63; }
.segment.active { background:var(--sage); color:#fff; box-shadow:0 6rpx 14rpx rgba(71,88,68,.18); }
.primary-button,.secondary-button,.danger-button { display:flex; align-items:center; justify-content:center; min-height:82rpx; margin:18rpx 0 0; padding:0 30rpx; border-radius:40rpx; font-size:29rpx; }
.primary-button { background:var(--sage); color:#fff; box-shadow:0 8rpx 18rpx rgba(76,92,71,.2); }
.secondary-button { border:1rpx solid #d8cec0; background:rgba(255,255,255,.66); color:#4e4a45; }
.danger-button { border:1rpx solid #e3b4a7; background:#fff6f2; color:#a6493d; }
.button-row { display:flex; gap:16rpx; }
.button-row button { flex:1; }
.mini-button { min-height:58rpx; margin:0; padding:0 22rpx; border-radius:30rpx; background:var(--sage); color:white; font-size:24rpx; line-height:58rpx; }
.mini-button.light { border:1rpx solid var(--line); background:rgba(255,255,255,.7); color:#4f4a44; }
.mini-button.peach { background:var(--peach-soft); color:#a85f4a; }
.field { margin-top:22rpx; }
.field-label { display:block; margin:0 4rpx 10rpx; color:#5d5851; font-size:25rpx; }
.input,.textarea,.picker { box-sizing:border-box; width:100%; min-height:78rpx; padding:18rpx 22rpx; border:1rpx solid #ddd2c4; border-radius:18rpx; background:rgba(255,255,255,.78); color:var(--ink); }
.textarea { min-height:150rpx; }
.task-row { display:flex; align-items:center; gap:18rpx; }
.check { width:48rpx; height:48rpx; flex:0 0 48rpx; border:3rpx solid #88847e; border-radius:14rpx; }
.check.done { position:relative; border-color:var(--sage); background:var(--sage); }
.check.done::after { content:""; position:absolute; left:13rpx; top:6rpx; width:13rpx; height:25rpx; border-right:4rpx solid white; border-bottom:4rpx solid white; transform:rotate(42deg); }
.empty,.error-panel { padding:70rpx 30rpx; text-align:center; color:var(--muted); }
.demo-banner { margin:-8rpx 0 20rpx; padding:14rpx 20rpx; border-radius:16rpx; background:#fff3cf; color:#775f2f; font-size:23rpx; text-align:center; }
.floating-add { position:fixed; right:32rpx; bottom:calc(150rpx + env(safe-area-inset-bottom)); z-index:20; display:flex; align-items:center; justify-content:center; width:100rpx; height:100rpx; border-radius:50%; background:var(--sage); color:white; box-shadow:0 12rpx 28rpx rgba(59,76,55,.28); font-size:50rpx; line-height:1; }
.modal-mask { position:fixed; inset:0; z-index:50; display:flex; align-items:flex-end; background:rgba(42,38,32,.42); }
.sheet { box-sizing:border-box; width:100%; max-height:88vh; padding:28rpx 26rpx calc(28rpx + env(safe-area-inset-bottom)); overflow-y:auto; border-radius:36rpx 36rpx 0 0; background:var(--canvas); }
.sheet-title { font-family:"STKaiti","KaiTi",serif; font-size:40rpx; font-weight:700; color:#344633; }
.divider { height:1rpx; margin:20rpx 0; background:var(--line); }
@import "styles/journal-fonts.wxss";
@import "styles/journal.wxss";
@import "styles/journal-surfaces.wxss";
