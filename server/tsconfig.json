{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["api/src/**/*.ts", "jobs/src/**/*.ts", "../shared/**/*.ts", "../scripts/**/*.ts"]
}
